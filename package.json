{
  "name": "dsh-model-picker-brand",
  "version": "0.1.1",
  "description": "Provider logos and model IDs in the DeepSeek Harness model picker — a label decorator on the official conversation.input.model.label slot, with registry-driven brand matching. Zero core changes.",
  "license": "MIT",
  "author": "zhangyongshuai",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model-picker",
    "provider-logo",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangyongshuai56-hub/dsh-model-picker-brand.git"
  },
  "homepage": "https://github.com/zhangyongshuai56-hub/dsh-model-picker-brand#readme",
  "bugs": {
    "url": "https://github.com/zhangyongshuai56-hub/dsh-model-picker-brand/issues"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test": "node tests/resolve.test.mjs"
  }
}
